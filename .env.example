# Postgres. Three roles per addendum §1.3.
DATABASE_URL=postgres://app_user:app_user_pw@localhost:5432/greenbar
DATABASE_URL_WORKER=postgres://app_worker:app_worker_pw@localhost:5432/greenbar
DATABASE_URL_ADMIN=postgres://app_admin:app_admin_pw@localhost:5432/greenbar

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Object storage (MinIO defaults for local dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=greenbar-documents
S3_FORCE_PATH_STYLE=true

# LLM gateway (addendum §2.2 — only models in src/lib/llm/registry.ts
# may be used for invoice traffic; the gateway refuses non-compliant ids).
ANTHROPIC_API_KEY=sk-ant-replace-me
