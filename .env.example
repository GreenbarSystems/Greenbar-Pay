# Postgres. Three roles per addendum §1.3.
DATABASE_URL=postgres://app_user:app_user_pw@localhost:5432/greenbar
DATABASE_URL_WORKER=postgres://app_worker:app_worker_pw@localhost:5432/greenbar
DATABASE_URL_ADMIN=postgres://app_admin:app_admin_pw@localhost:5432/greenbar

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Dev-only Credentials login (src/lib/auth.ts). Lets local dev / CI / agents
# sign in without a live SMTP transport. Requires BOTH:
#   - NODE_ENV !== "production" (enforced by an in-code boot assertion that
#     throws if this is ever set with NODE_ENV=production)
#   - a matching `secret` field posted alongside the email
# Leave unset in any deployed environment. Generate with:
#   openssl rand -base64 32
# DEV_LOGIN_SECRET=replace-with-openssl-rand-base64-32-dev-only

# Magic-link sign-in. With SMTP_HOST unset, the dev console transport
# prints the click-this link to stdout (and writes to
# .next-auth-dev-link.txt). For prod, point at SES / SendGrid /
# Mailgun / Postfix — any SMTP endpoint works.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false                # true for 465; false for 587/STARTTLS
# SMTP_USER=
# SMTP_PASSWORD=
AUTH_EMAIL_FROM=noreply@greenbarpay.local
AUTH_EMAIL_PRODUCT_NAME=Greenbar Pay

# ClamAV daemon (addendum §2.6 / 2026-07-13 audit F3). Required in
# production — src/lib/security/clamav.ts's boot assertion refuses to
# start with NODE_ENV=production and no CLAMD_HOST set, so every
# upload/emailed attachment is scanned before it's accepted.
# Local dev: `docker compose up -d clamav` provides one on this port
# (first boot downloads virus definitions and can take a couple of
# minutes before the healthcheck passes). Leaving CLAMD_HOST unset
# outside production disables AV scanning with a loud console warning
# instead of failing — every file is accepted unscanned.
CLAMD_HOST=localhost
CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=15000

# Object storage (MinIO defaults for local dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=greenbar-documents
S3_FORCE_PATH_STYLE=true

# docker-compose credential overrides (2026-07-13 audit F14).
# docker-compose.yml uses ${VAR:-default} substitution so these values
# can stay unset for local dev (the defaults below are used). For any
# shared/production docker-compose deployment, set these in a .env file
# at the repo root (gitignored) with strong random values:
#   openssl rand -base64 32
# POSTGRES_PASSWORD=app_admin_pw
# APP_USER_PW=app_user_pw
# APP_WORKER_PW=app_worker_pw
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# LLM gateway (addendum §2.2 — only models in src/lib/llm/registry.ts
# may be used for invoice traffic; the gateway refuses non-compliant ids).
ANTHROPIC_API_KEY=sk-ant-replace-me

# AP inbox (addendum §3). Production wires SES → S3 → SNS → SQS.
# Unset INBOX_SQS_QUEUE_URL leaves the poller off — local dev uses
# `pnpm ingest:eml <file.eml>` instead.
# INBOX_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<acct>/ap-inbox-incoming
# SQS_ENDPOINT=                  # set to a LocalStack URL when developing against fake AWS

# Feature flags. See src/lib/featureFlags.ts and CLAUDE.md.
# ENABLE_MULTI_CLIENT lifts the multi-client (CPA-firm) freeze and
# re-exposes the clients table, per-client AP inbox routing, per-client
# RBAC scoping, and the client picker/filter UI. Default off — the
# product is solo-first (one customer org per account).
# ENABLE_MULTI_CLIENT=true
