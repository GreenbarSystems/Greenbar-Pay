{
  "name": "greenbar-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --no-cache",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:check": "tsx scripts/migrate-check.ts",
    "db:verify-partition-backfill": "tsx scripts/verify-partition-backfill.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:rls": "vitest run src/db/__tests__/rls.test.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:dev": "tsx watch scripts/worker.ts",
    "benchmark": "tsx scripts/benchmark-extraction.ts",
    "benchmark:dry-run": "tsx scripts/benchmark-extraction.ts --dry-run",
    "ingest:eml": "tsx scripts/ingest-eml.ts",
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@auth/drizzle-adapter": "^1.7.4",
    "@types/nodemailer": "^7.0.12",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "mailparser": "^3.7.2",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.4.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.703.0",
    "@aws-sdk/client-sqs": "^3.703.0",
    "@aws-sdk/s3-request-presigner": "^3.703.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
