# npm v7+ enforces peerDependencies strictly. We have a known-safe
# peerOptional mismatch in the auth/nodemailer/mailparser chain:
#
#   next-auth@5.0.0-beta.31     -> peerOptional nodemailer@^7.0.7
#   @auth/drizzle-adapter@1.11  -> @auth/core@0.41 -> peerOptional nodemailer@^7
#   mailparser@3.9              -> nodemailer@9.0.1 (nested, isolated)
#
# Root nodemailer is pinned at ^7.0.13 to match the next-auth peer. The
# nested mailparser copy is isolated and harmless, but npm's strict
# resolver still refuses the install without this flag.
#
# Revisit if nodemailer is bumped to ^9 (clears the remaining CVE chain)
# and the auth packages catch up to ^9 as well.
legacy-peer-deps=true
