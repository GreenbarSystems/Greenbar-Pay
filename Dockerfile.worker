# Worker-only image. Differs from the web Dockerfile in two ways:
#
#   1. No `npm run build` step. The worker runs TypeScript source
#      directly via tsx; there is no Next.js build output to ship.
#      Saves ~30-60s of build time and ~30-50 MB of .next/ artifacts
#      per CI run.
#
#   2. Cherry-picks only the directories the worker actually needs
#      (src/db, src/jobs, src/lib, scripts, tsconfig*). src/app and
#      public/ never enter the image. `tsconfig.worker.json` enforces
#      the boundary at typecheck time so web-only imports cannot
#      sneak in via the gateway-pattern lib code.
#
# Both images still install the full root package.json dependency
# tree — splitting dependencies between web and worker requires a
# monorepo split (apps/web + apps/worker), which is deferred. See
# CLAUDE.md for the larger structural plan.

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* .npmrc ./
# .npmrc supplies legacy-peer-deps=true to satisfy the auth/nodemailer
# peerOptional chain documented in .npmrc.
RUN npm install --no-audit --no-fund

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
# tesseract.js caches language data here on first run.
ENV TESSDATA_PREFIX=/app/.tesseract
# pdftoppm (poppler-utils) rasterizes scanned PDFs for the OCR fallback
# in src/lib/ocr/pdf-rasterize.ts.
RUN apk add --no-cache poppler-utils
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json tsconfig.worker.json ./
COPY src/db ./src/db
COPY src/jobs ./src/jobs
COPY src/lib ./src/lib
COPY scripts ./scripts

# F5 fix (2026-07-12 security audit): don't run as root. This image
# parses untrusted, user-uploaded/emailed PDFs via pdftoppm/tesseract in
# the OCR job pipeline — a parser bug there shouldn't hand an attacker a
# root shell in the container. node:20-alpine ships a non-root `node`
# user (uid/gid 1000) built in; `chown` is needed because COPY defaults
# to root ownership and tesseract.js writes to /app at runtime
# (language-data cache under TESSDATA_PREFIX).
RUN chown -R node:node /app
USER node

# No HTTP port to expose. Crashes restart per docker-compose policy;
# pg-boss redelivers any in-flight jobs.
CMD ["npx", "tsx", "scripts/worker.ts"]
